<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Virtual" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Container hosts draw their own placeholder and headless launches stay
         invisible, so suppress the system starting window. -->
    <style name="Theme.Virtual.Container" parent="Theme.Virtual">
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Virtual.Assistant" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/assistant_voice_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>