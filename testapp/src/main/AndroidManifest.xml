<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light">
        <meta-data
            android:name="REQUIRE_SECURE_ENV"
            android:value="${requireSecureEnv}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SecondActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="com.coke.testapp.OPEN_SECOND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="second"
                    android:scheme="nestspace" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ThirdActivity"
            android:exported="false" />

        <activity
            android:name=".SubprocessActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:process=":worker" />

        <activity
            android:name=".SingleTopActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".SingleTaskActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".StackActivity"
            android:exported="false" />

        <activity
            android:name=".SingleInstanceActivity"
            android:exported="false"
            android:launchMode="singleInstance" />

        <activity
            android:name=".StandardChildActivity"
            android:exported="false" />

        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <service
            android:name=".TestJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".TestService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.coke.testapp.PING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".TestWorkerService"
            android:exported="false"
            android:process=":worker" />

        <provider
            android:name=".TestProvider"
            android:authorities="com.coke.testapp.testprovider"
            android:exported="false" />

        <provider
            android:name=".TestWorkerProvider"
            android:authorities="com.coke.testapp.workerprovider"
            android:exported="false"
            android:process=":worker" />

        <receiver
            android:name=".TestReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.coke.testapp.PING_RECEIVER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.coke.testapp.ORDERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TestProcessReceiver"
            android:exported="false"
            android:process=":worker">
            <intent-filter>
                <action android:name="com.coke.testapp.PROCESS_PING" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
