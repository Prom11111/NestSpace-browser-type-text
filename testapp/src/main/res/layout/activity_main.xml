<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#17243A"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/run_compatibility_suite"
                style="@style/TestApp.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/run_compatibility_suite" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/section_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F4F6FA">

            <ScrollView
                android:id="@+id/menu_root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="12dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp"
                        android:text="@string/test_menu"
                        android:textColor="#68768C"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/menu_overview"
                        style="@style/TestApp.MenuRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TestApp.MenuTitle"
                                android:text="@string/tab_overview" />

                            <TextView
                                style="@style/TestApp.MenuSummary"
                                android:text="@string/menu_overview_summary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#8C98AA"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menu_components"
                        style="@style/TestApp.MenuRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TestApp.MenuTitle"
                                android:text="@string/tab_components" />

                            <TextView
                                style="@style/TestApp.MenuSummary"
                                android:text="@string/menu_components_summary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#8C98AA"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menu_system"
                        style="@style/TestApp.MenuRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TestApp.MenuTitle"
                                android:text="@string/tab_system" />

                            <TextView
                                style="@style/TestApp.MenuSummary"
                                android:text="@string/menu_system_summary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#8C98AA"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menu_compatibility"
                        style="@style/TestApp.MenuRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TestApp.MenuTitle"
                                android:text="@string/tab_compatibility" />

                            <TextView
                                style="@style/TestApp.MenuSummary"
                                android:text="@string/menu_compatibility_summary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#8C98AA"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menu_process"
                        style="@style/TestApp.MenuRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TestApp.MenuTitle"
                                android:text="@string/tab_process" />

                            <TextView
                                style="@style/TestApp.MenuSummary"
                                android:text="@string/menu_process_summary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#8C98AA"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menu_identity"
                        style="@style/TestApp.MenuRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TestApp.MenuTitle"
                                android:text="@string/tab_identity" />

                            <TextView
                                style="@style/TestApp.MenuSummary"
                                android:text="@string/menu_identity_summary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="#8C98AA"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/current_environment" />

                        <TextView
                            android:id="@+id/text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/hello"
                            android:textColor="#1F2A3D"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/info"
                            style="@style/TestApp.Result"
                            android:maxLines="6" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/section_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="12dp">

                    <Button
                        android:id="@+id/back_to_menu"
                        style="@style/TestApp.TabButton"
                        android:text="@string/back_to_menu" />

                    <TextView
                        android:id="@+id/section_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:textColor="#1F2A3D"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/section_content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

            <ScrollView
                android:id="@+id/tab_overview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="8dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/basic_interaction" />

                        <EditText
                            android:id="@+id/ime_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:hint="InputMethod test"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:minHeight="48dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/button"
                                style="@style/TestApp.Button"
                                android:text="@string/click_me" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/page_navigation" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/open_second"
                                style="@style/TestApp.Button"
                                android:text="@string/open_second" />

                            <Button
                                android:id="@+id/open_second_result"
                                style="@style/TestApp.Button"
                                android:text="@string/open_second_result" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/open_implicit"
                                style="@style/TestApp.Button"
                                android:text="@string/open_implicit" />

                            <Button
                                android:id="@+id/open_splash"
                                style="@style/TestApp.Button"
                                android:text="@string/open_splash" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/open_single_top"
                                style="@style/TestApp.Button"
                                android:text="@string/open_single_top" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tab_components"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="8dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/component_bridge" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/implicit_service"
                                style="@style/TestApp.Button"
                                android:text="@string/implicit_service" />

                            <Button
                                android:id="@+id/start_service"
                                style="@style/TestApp.Button"
                                android:text="@string/start_service" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/bind_service"
                                style="@style/TestApp.Button"
                                android:text="@string/bind_service" />

                            <Button
                                android:id="@+id/query_provider"
                                style="@style/TestApp.Button"
                                android:text="@string/query_provider" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/service_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/package_manager" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/pm_check"
                                style="@style/TestApp.Button"
                                android:text="@string/pm_check" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/pm_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/broadcast_tests" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/send_static_broadcast"
                                style="@style/TestApp.Button"
                                android:text="@string/send_static_broadcast" />

                            <Button
                                android:id="@+id/send_dynamic_broadcast"
                                style="@style/TestApp.Button"
                                android:text="@string/send_dynamic_broadcast" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/send_ordered_broadcast"
                                style="@style/TestApp.Button"
                                android:text="@string/send_ordered_broadcast" />

                            <Button
                                android:id="@+id/send_sticky_broadcast"
                                style="@style/TestApp.Button"
                                android:text="@string/send_sticky_broadcast" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/broadcast_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tab_system"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="8dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/system_capabilities" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/request_permission"
                                style="@style/TestApp.Button"
                                android:text="@string/request_permission" />

                            <Button
                                android:id="@+id/schedule_job"
                                style="@style/TestApp.Button"
                                android:text="@string/schedule_job" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/permission_result"
                            style="@style/TestApp.Result" />

                        <TextView
                            android:id="@+id/job_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>

                    <LinearLayout style="@style/TestApp.Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/post_notification"
                                style="@style/TestApp.Button"
                                android:text="@string/post_notification" />

                            <Button
                                android:id="@+id/vpms_query"
                                style="@style/TestApp.Button"
                                android:text="@string/vpms_query" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/notification_result"
                            style="@style/TestApp.Result" />

                        <TextView
                            android:id="@+id/vpms_result"
                            style="@style/TestApp.Result" />

                        <TextView
                            android:id="@+id/system_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tab_compatibility"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="8dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/compatibility_results" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/compatibility_hint"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/storage_result"
                            style="@style/TestApp.Result" />

                        <TextView
                            android:id="@+id/account_result"
                            style="@style/TestApp.Result" />

                        <TextView
                            android:id="@+id/native_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tab_process"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="8dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/process_tests" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/send_process_broadcast"
                                style="@style/TestApp.Button"
                                android:text="@string/send_process_broadcast" />

                            <Button
                                android:id="@+id/start_worker_service"
                                style="@style/TestApp.Button"
                                android:text="@string/start_worker_service" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/query_worker_provider"
                                style="@style/TestApp.Button"
                                android:text="@string/query_worker_provider" />

                            <Button
                                android:id="@+id/open_subprocess_result"
                                style="@style/TestApp.Button"
                                android:text="@string/open_subprocess_result" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/process_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/tab_identity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:padding="8dp"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/TestApp.Card">

                        <TextView
                            style="@style/TestApp.SectionTitle"
                            android:text="@string/identity_tests" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/test_system_attribution"
                                style="@style/TestApp.Button"
                                android:text="@string/test_system_attribution" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/attribution_result"
                            style="@style/TestApp.Result" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/test_services"
                                style="@style/TestApp.Button"
                                android:text="@string/test_services" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/services_result"
                            style="@style/TestApp.Result" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/test_ime"
                                style="@style/TestApp.Button"
                                android:text="@string/test_ime" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/ime_result"
                            style="@style/TestApp.Result" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
</LinearLayout>
