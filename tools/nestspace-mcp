#!/usr/bin/env python3
"""Command line client for the NestSpace MCP server.

Uses only the Python standard library. The server speaks MCP Streamable HTTP
at /mcp; the bearer token is read from --token, --token-file or
NESTSPACE_MCP_TOKEN and is never printed.
"""

import argparse
import http.client
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "http://127.0.0.1:8765/mcp"
PROTOCOL_VERSION = "2025-06-18"
CLIENT_NAME = "nestspace-mcp-cli"
CLIENT_VERSION = "0.1.0"


class McpError(Exception):
    pass


class McpHttpError(McpError):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


class SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Do not forward the control token to a different origin."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        redirected = super().redirect_request(req, fp, code, msg, headers, newurl)
        if redirected is not None:
            old = urllib.parse.urlsplit(req.full_url)
            new = urllib.parse.urlsplit(newurl)
            if (old.scheme, old.hostname, old.port) != (
                new.scheme,
                new.hostname,
                new.port,
            ):
                redirected.remove_header("Authorization")
                redirected.remove_header("Mcp-Session-Id")
        return redirected


OPENER = urllib.request.build_opener(SafeRedirectHandler())


def json_dump(value, pretty=True):
    if pretty:
        return json.dumps(value, ensure_ascii=False, indent=2)
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def parse_value(text):
    """Coerce --arg values while leaving ordinary strings intact."""
    lowered = text.lower()
    if lowered == "true":
        return True
    if lowered == "false":
        return False
    if lowered == "null":
        return None
    try:
        return int(text)
    except ValueError:
        pass
    try:
        return float(text)
    except ValueError:
        pass
    if text[:1] in "{[":
        try:
            return json.loads(text)
        except ValueError:
            pass
    return text


class McpClient:
    def __init__(self, url, token, timeout):
        self.url = url
        self.token = (token or "").strip()
        self.timeout = timeout
        self.session_id = None
        self.next_id = 1
        self.initialized = False

    def _headers(self):
        headers = {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": PROTOCOL_VERSION,
            "User-Agent": f"{CLIENT_NAME}/{CLIENT_VERSION}",
        }
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        if self.session_id:
            headers["Mcp-Session-Id"] = self.session_id
        return headers

    def _post(self, payload):
        body = json_dump(payload, pretty=False).encode("utf-8")
        request = urllib.request.Request(
            self.url, data=body, headers=self._headers(), method="POST"
        )
        try:
            with OPENER.open(request, timeout=self.timeout) as response:
                raw = response.read()
                session = response.headers.get("Mcp-Session-Id")
                if session:
                    self.session_id = session
                content_type = response.headers.get("Content-Type", "")
        except urllib.error.HTTPError as error:
            detail = error.read().decode("utf-8", "replace").strip()
            if error.code == 401:
                raise McpHttpError(
                    401,
                    "unauthorized: check --token, --token-file or NESTSPACE_MCP_TOKEN",
                ) from None
            raise McpHttpError(
                error.code, f"HTTP {error.code}: {detail[:500]}"
            ) from None
        except (
            ConnectionResetError,
            http.client.RemoteDisconnected,
            http.client.BadStatusLine,
        ) as error:
            raise McpError(
                f"connection closed by server: {error} "
                "(the server may be at capacity or restarting)"
            ) from None
        except urllib.error.URLError as error:
            raise McpError(
                f"cannot reach {self.url}: {error.reason}; "
                "for USB run 'adb forward tcp:8765 tcp:8765' or use the LAN address"
            ) from None
        except TimeoutError:
            raise McpError(f"request timed out after {self.timeout}s") from None

        if not raw:
            return None
        text = raw.decode("utf-8", "replace")
        if "text/event-stream" in content_type.lower():
            events = []
            for line in text.splitlines():
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if not payload:
                    continue
                try:
                    events.append(json.loads(payload))
                except ValueError:
                    continue
            if not events:
                raise McpError("empty SSE response")
            chosen = next(
                (
                    event
                    for event in reversed(events)
                    if isinstance(event, dict)
                    and ("result" in event or "error" in event)
                ),
                None,
            )
            if chosen is None:
                raise McpError("SSE response contained no result")
            return chosen
        try:
            return json.loads(text)
        except ValueError:
            raise McpError(f"invalid JSON response: {text[:300]}") from None

    def _request(self, method, params=None):
        try:
            return self._request_once(method, params)
        except McpHttpError as error:
            # The server may have restarted (for example, when LAN mode was
            # toggled); transparently initialize a new session and retry once.
            if error.status == 404 and self.session_id and method != "initialize":
                self.session_id = None
                self.initialized = False
                self.initialize()
                return self._request_once(method, params)
            raise

    def _request_once(self, method, params=None):
        payload = {
            "jsonrpc": "2.0",
            "id": self.next_id,
            "method": method,
        }
        self.next_id += 1
        if params is not None:
            payload["params"] = params
        response = self._post(payload)
        if response is None:
            raise McpError("empty response")
        if not isinstance(response, dict):
            raise McpError("malformed JSON-RPC response: expected an object")
        if "error" in response:
            error = response.get("error") or {}
            if not isinstance(error, dict):
                error = {}
            raise McpError(
                f"{error.get('message', 'JSON-RPC error')} "
                f"(code {error.get('code', '?')})"
            )
        return response.get("result")

    def initialize(self):
        if self.initialized:
            return
        self._request(
            "initialize",
            {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {},
                "clientInfo": {"name": CLIENT_NAME, "version": CLIENT_VERSION},
            },
        )
        # Notification; the server returns 202 with an empty body.
        self._post({"jsonrpc": "2.0", "method": "notifications/initialized"})
        self.initialized = True

    def list_tools(self):
        self.initialize()
        result = self._request("tools/list")
        if result is None:
            return []
        if not isinstance(result, dict):
            raise McpError("malformed tools/list result: expected an object")
        tools = result.get("tools", [])
        if not isinstance(tools, list):
            raise McpError("malformed tools/list result: tools is not a list")
        return [tool for tool in tools if isinstance(tool, dict)]

    def call_tool(self, name, arguments):
        self.initialize()
        result = self._request(
            "tools/call", {"name": name, "arguments": arguments}
        )
        if not isinstance(result, dict):
            raise McpError("malformed tools/call result: expected an object")
        return result

    def close_session(self):
        """Send DELETE /mcp for the active session. Returns False if none."""
        if not self.session_id:
            return False
        request = urllib.request.Request(
            self.url, headers=self._headers(), method="DELETE"
        )
        try:
            with OPENER.open(request, timeout=self.timeout) as response:
                return response.status in (200, 204)
        except urllib.error.HTTPError as error:
            if error.code == 404:
                return False
            if error.code == 401:
                raise McpHttpError(401, "unauthorized while closing session") from None
            detail = error.read().decode("utf-8", "replace").strip()
            raise McpError(f"HTTP {error.code}: {detail[:300]}") from None
        except (
            urllib.error.URLError,
            ConnectionResetError,
            http.client.RemoteDisconnected,
            http.client.BadStatusLine,
            TimeoutError,
        ) as error:
            reason = getattr(error, "reason", error)
            raise McpError(f"cannot close session: {reason}") from None
        finally:
            self.session_id = None
            self.initialized = False


def read_token(args):
    if args.token:
        return args.token.strip()
    if args.token_file:
        try:
            with open(args.token_file, "r", encoding="utf-8") as handle:
                return handle.read().strip()
        except OSError as error:
            raise McpError(f"cannot read token file: {error}") from None
    return os.environ.get("NESTSPACE_MCP_TOKEN", "").strip()


def require_token(client):
    if not client.token:
        raise McpError(
            "no token: pass --token/--token-file or set NESTSPACE_MCP_TOKEN"
        )


def health_url(endpoint):
    parsed = urllib.parse.urlsplit(endpoint)
    path = (parsed.path or "/mcp").rstrip("/") or "/mcp"
    if path.endswith("/mcp"):
        path = path[: -len("/mcp")] + "/health"
    else:
        path = path + "/health"
    return urllib.parse.urlunsplit(
        (parsed.scheme, parsed.netloc, path, "", "")
    )


def command_health(args, client):
    url = health_url(client.url)
    try:
        with OPENER.open(url, timeout=client.timeout) as response:
            body = response.read().decode("utf-8", "replace").strip()
            if args.json:
                print(json_dump({"status": response.status, "body": body, "url": url}))
            else:
                print(f"{response.status} {body or 'ok'}")
    except urllib.error.HTTPError as error:
        raise McpError(f"health check failed: HTTP {error.code}") from None
    except (
        urllib.error.URLError,
        ConnectionResetError,
        http.client.RemoteDisconnected,
        http.client.BadStatusLine,
        TimeoutError,
    ) as error:
        reason = getattr(error, "reason", error)
        raise McpError(f"health check failed: {reason}") from None


def command_tools(args, client):
    require_token(client)
    tools = client.list_tools()
    if args.json:
        print(json_dump({"tools": tools}))
        return
    for tool in tools:
        raw_description = tool.get("description")
        description = raw_description.splitlines()[0] if isinstance(
            raw_description, str
        ) and raw_description.splitlines() else ""
        if len(description) > 110:
            description = description[:107] + "..."
        print(f"{tool.get('name', '?'):<30} {description}")
    print(f"\n{len(tools)} tools", file=sys.stderr)


def build_arguments(args):
    if args.arguments is not None and args.arg:
        raise McpError("use either a JSON argument object or --arg, not both")
    if args.arguments is not None:
        raw = args.arguments
        if raw == "-":
            raw = sys.stdin.read()
        try:
            value = json.loads(raw)
        except ValueError as error:
            raise McpError(f"arguments must be a JSON object: {error}") from None
        if not isinstance(value, dict):
            raise McpError("arguments must be a JSON object")
        return value
    result = {}
    for item in args.arg or []:
        if "=" not in item:
            raise McpError(f"--arg must be KEY=VALUE: {item}")
        key, value = item.split("=", 1)
        key = key.strip()
        if not key:
            raise McpError("--arg key cannot be empty")
        result[key] = parse_value(value)
    return result


def print_tool_result(result, raw_json):
    if raw_json:
        print(json_dump(result))
        return bool(result.get("isError"))
    content = result.get("content")
    if not isinstance(content, list):
        content = [{"type": "text", "text": json_dump(result)}]
    for item in content:
        if not isinstance(item, dict):
            print(json_dump(item))
            continue
        kind = item.get("type")
        if kind == "text":
            print(item.get("text", ""))
        elif kind == "image":
            data = item.get("data") or ""
            mime = item.get("mimeType") or "image"
            print(f"[image {mime}, {len(data)} base64 chars]")
        else:
            print(json_dump(item))
    return bool(result.get("isError"))


def command_call(args, client):
    require_token(client)
    arguments = build_arguments(args)
    result = client.call_tool(args.name, arguments)
    if result is None:
        raise McpError("empty tool result")
    return 1 if print_tool_result(result, args.json) else 0


def command_setup(args, client):
    url = client.url
    print("export NESTSPACE_MCP_URL=" + url)
    print("export NESTSPACE_MCP_TOKEN='<copy the token from NestSpace settings>'")
    print()
    print("tools/nestspace-mcp tools")
    print("tools/nestspace-mcp call browser_tabs")
    print()
    print(
        'claude mcp add --transport http nestspace "$NESTSPACE_MCP_URL" '
        '--header "Authorization: Bearer $NESTSPACE_MCP_TOKEN"'
    )


class Shell:
    """Small interactive REPL. Commands mirror the one-shot CLI."""

    def __init__(self, client):
        self.client = client

    def run(self):
        print("NestSpace MCP shell. Commands: tools, call, health, disconnect, quit")
        try:
            tools = self.client.list_tools()
            print(f"{len(tools)} tools available")
        except McpError as error:
            print(f"not connected: {error}", file=sys.stderr)
        while True:
            try:
                line = input("nestspace> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return 0
            if not line:
                continue
            if line in ("quit", "exit"):
                return 0
            if line in ("help", "?"):
                print("tools | call NAME [JSON] | health | disconnect | quit")
                continue
            if line == "disconnect":
                try:
                    closed = self.client.close_session()
                    print("session closed" if closed else "no active session")
                except McpError as error:
                    print(f"error: {error}", file=sys.stderr)
                continue
            if line == "tools":
                try:
                    for tool in self.client.list_tools():
                        raw_description = tool.get("description")
                        description = raw_description.splitlines()[0] if isinstance(
                            raw_description, str
                        ) and raw_description.splitlines() else ""
                        print(f"{tool.get('name', '?')}\t{description}")
                except McpError as error:
                    print(f"error: {error}", file=sys.stderr)
                continue
            if line == "health":
                try:
                    url = health_url(self.client.url)
                    with OPENER.open(url, timeout=self.client.timeout) as response:
                        print(f"{response.status} "
                              f"{response.read().decode('utf-8', 'replace').strip()}")
                except Exception as error:  # noqa: BLE001 - keep the shell alive
                    print(f"error: {error}", file=sys.stderr)
                continue
            if line.startswith("call "):
                rest = line[5:].strip()
                if not rest:
                    print("usage: call NAME [JSON]", file=sys.stderr)
                    continue
                name, _, raw = rest.partition(" ")
                try:
                    arguments = json.loads(raw) if raw.strip() else {}
                    if not isinstance(arguments, dict):
                        raise ValueError("arguments must be a JSON object")
                    result = self.client.call_tool(name.strip(), arguments)
                    print_tool_result(result or {}, False)
                except (McpError, ValueError) as error:
                    print(f"error: {error}", file=sys.stderr)
                continue
            print("unknown command; try tools, call, health, quit", file=sys.stderr)


def add_common_options(parser):
    parser.add_argument(
        "--url",
        default=os.environ.get("NESTSPACE_MCP_URL", DEFAULT_URL),
        help=f"MCP endpoint (default {DEFAULT_URL})",
    )
    parser.add_argument("--token", help="bearer token (prefer env or --token-file)")
    parser.add_argument("--token-file", help="file containing the bearer token")
    parser.add_argument("--timeout", type=float, default=60.0, help="request timeout")
    parser.add_argument("--json", action="store_true", help="print raw JSON")


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="nestspace-mcp",
        description="CLI client for the NestSpace MCP server",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  nestspace-mcp tools\n"
            "  nestspace-mcp call browser_tabs\n"
            '  nestspace-mcp call browser_open \'{"url":"https://example.com"}\'\n'
            "  nestspace-mcp call browser_open --arg url=https://example.com "
            "--arg headless=false\n"
            "  nestspace-mcp shell\n\n"
            "Environment: NESTSPACE_MCP_URL, NESTSPACE_MCP_TOKEN"
        ),
    )
    add_common_options(parser)
    json_only = argparse.ArgumentParser(add_help=False)
    json_only.add_argument(
        "--json",
        action="store_true",
        default=argparse.SUPPRESS,
        help="print raw JSON",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser(
        "health", parents=[json_only], help="check /health without calling a tool"
    )
    subparsers.add_parser(
        "tools", parents=[json_only], help="list available MCP tools"
    )

    call = subparsers.add_parser(
        "call", parents=[json_only], help="call one tool"
    )
    call.add_argument("name", help="tool name")
    call.add_argument(
        "arguments",
        nargs="?",
        help="JSON object; use - to read it from stdin",
    )
    call.add_argument(
        "--arg",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help="repeatable key/value argument; values are auto-typed",
    )

    subparsers.add_parser(
        "shell", parents=[json_only], help="interactive tool-call shell"
    )
    subparsers.add_parser(
        "setup", help="print shell and Claude Code setup commands"
    )

    args = parser.parse_args(argv)
    try:
        token = "" if args.command in ("health", "setup") else read_token(args)
        client = McpClient(args.url, token, args.timeout)
        if args.command == "health":
            command_health(args, client)
            return 0
        if args.command == "tools":
            command_tools(args, client)
            return 0
        if args.command == "call":
            return command_call(args, client)
        if args.command == "shell":
            require_token(client)
            return Shell(client).run()
        if args.command == "setup":
            command_setup(args, client)
            return 0
    except McpError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
